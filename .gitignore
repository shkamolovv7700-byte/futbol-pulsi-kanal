# Faqat kanal uchun kerakli fayllar GitHub'ga yuklanadi.
# .env, *.session va boshqa maxfiy fayllar hech qachon yuklanmaydi.
*
!.gitignore
!.github/
!.github/workflows/
!.github/workflows/kanal.yml
!bulut.py
!kanal.py
!statistika.py
!kanal_kontent.json
!kanal_state.json
!requirements-bulut.txt
!rasm.py
!shriftlar/
!shriftlar/*
!moderator.py
!cs2.py
!cs2data.py
!cs2_kontent.json
!cs2_state.json
!.github/workflows/cs2.yml
!setka.py
!reklama_bot.py
!reklama_narxlar.json
!requirements-bot.txt
!.github/workflows/bot.yml
!foto.py
